{
  "mcpServers": {
    "suews": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/server",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/server/run_server.py"
      ],
      "env": {
        "UV_PYTHON": ">=3.12,<3.14"
      }
    }
  }
}
